<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude false positives and acceptable security patterns -->
    
    <!-- JWT token handling is secure -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD" />
        <Class name="org.abimon.eternalJukebox.security.SecurityConfig" />
        <Method name="generateToken" />
    </Match>
    
    <!-- URL validation is intentionally restrictive -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD" />
        <Class name="org.abimon.eternalJukebox.security.SecurityConfig" />
        <Method name="isValidUrl" />
    </Match>
    
    <!-- Password hashing is secure -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD" />
        <Class name="org.abimon.eternalJukebox.security.SecurityConfig" />
        <Method name="hashPassword" />
    </Match>
    
    <!-- Test files are excluded -->
    <Match>
        <Class name="~.*Test.*" />
    </Match>
    
    <!-- Exclude third-party libraries -->
    <Match>
        <Package name="~com\.github\..*" />
    </Match>
    
    <Match>
        <Package name="~com\.fasterxml\..*" />
    </Match>
    
    <Match>
        <Package name="~io\.vertx\..*" />
    </Match>
    
    <!-- Exclude specific security patterns that are intentionally used -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD" />
        <Class name="org.abimon.eternalJukebox.security.SecurityConfig" />
        <Field name="jwtSecret" />
    </Match>
    
    <!-- Exclude false positives for security headers -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD" />
        <Class name="org.abimon.eternalJukebox.security.SecurityConfig" />
        <Field name="securityHeaders" />
    </Match>
    
    <!-- Exclude rate limiting configuration -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD" />
        <Class name="org.abimon.eternalJukebox.security.SecurityConfig" />
        <Field name="rateLimitRequests" />
    </Match>
    
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD" />
        <Class name="org.abimon.eternalJukebox.security.SecurityConfig" />
        <Field name="rateLimitWindowMs" />
    </Match>
</FindBugsFilter>
