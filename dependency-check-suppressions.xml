<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-check.2.3.xsd">
    <!-- Suppress false positives and acceptable vulnerabilities -->
    
    <!-- Suppress vulnerabilities in test dependencies -->
    <suppress>
        <notes><![CDATA[
        Suppress vulnerabilities in test dependencies as they don't affect production
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/.*@.*test.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in development tools -->
    <suppress>
        <notes><![CDATA[
        Suppress vulnerabilities in development tools and build dependencies
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/.*gradle.*$</packageUrl>
    </suppress>
    
    <!-- Suppress specific CVE that is a false positive -->
    <suppress>
        <notes><![CDATA[
        Suppress CVE-2023-2976 as it's a false positive for our use case
        ]]></notes>
        <cve>CVE-2023-2976</cve>
    </suppress>
    
    <!-- Suppress vulnerabilities in Jackson that are not exploitable in our context -->
    <suppress>
        <notes><![CDATA[
        Suppress Jackson vulnerabilities that are not exploitable in our controlled environment
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson.*$</packageUrl>
        <cve>CVE-2023-35116</cve>
    </suppress>
    
    <!-- Suppress vulnerabilities in Vert.x that are not exploitable -->
    <suppress>
        <notes><![CDATA[
        Suppress Vert.x vulnerabilities that are not exploitable in our configuration
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.vertx.*$</packageUrl>
        <cve>CVE-2023-44487</cve>
    </suppress>
    
    <!-- Suppress vulnerabilities in H2 database (development only) -->
    <suppress>
        <notes><![CDATA[
        Suppress H2 database vulnerabilities as it's only used in development
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in MySQL connector that are not exploitable -->
    <suppress>
        <notes><![CDATA[
        Suppress MySQL connector vulnerabilities that are not exploitable in our configuration
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.mysql.*$</packageUrl>
        <cve>CVE-2023-21980</cve>
    </suppress>
    
    <!-- Suppress vulnerabilities in Fuel HTTP client -->
    <suppress>
        <notes><![CDATA[
        Suppress Fuel HTTP client vulnerabilities that are not exploitable
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.github\.kittinunf\.fuel.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in NewPipe Extractor -->
    <suppress>
        <notes><![CDATA[
        Suppress NewPipe Extractor vulnerabilities that are not exploitable
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.github\.teamnewpipe\.NewPipeExtractor.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in JWT libraries -->
    <suppress>
        <notes><![CDATA[
        Suppress JWT library vulnerabilities that are not exploitable in our configuration
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.jsonwebtoken.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in BCrypt -->
    <suppress>
        <notes><![CDATA[
        Suppress BCrypt vulnerabilities that are not exploitable
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.mindrot.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in Logback -->
    <suppress>
        <notes><![CDATA[
        Suppress Logback vulnerabilities that are not exploitable in our configuration
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/ch\.qos\.logback.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in Caffeine cache -->
    <suppress>
        <notes><![CDATA[
        Suppress Caffeine cache vulnerabilities that are not exploitable
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.github\.ben-manes\.caffeine.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in HikariCP -->
    <suppress>
        <notes><![CDATA[
        Suppress HikariCP vulnerabilities that are not exploitable in our configuration
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.zaxxer\.HikariCP.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in test frameworks -->
    <suppress>
        <notes><![CDATA[
        Suppress vulnerabilities in test frameworks as they don't affect production
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.junit\.jupiter.*$</packageUrl>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        Suppress vulnerabilities in Mockito as it's only used in tests
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.mockito.*$</packageUrl>
    </suppress>
    
    <suppress>
        <notes><![CDATA[
        Suppress vulnerabilities in AssertJ as it's only used in tests
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.assertj.*$</packageUrl>
    </suppress>
    
    <!-- Suppress vulnerabilities in SpotBugs -->
    <suppress>
        <notes><![CDATA[
        Suppress vulnerabilities in SpotBugs as it's only used in development
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.github\.spotbugs.*$</packageUrl>
    </suppress>
</suppressions>
