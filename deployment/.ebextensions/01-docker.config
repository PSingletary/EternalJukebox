option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: 8080
    ANALYSIS_SERVICE_URL: "http://eternaljukebox-analysis:5000"
    STORAGE_TYPE: "LOCAL"
    DATABASE_TYPE: "H2"
    WORKER_EXECUTE_TIME: "1200000000000"
  aws:elasticbeanstalk:container:docker:
    DockerVersion: 20.10.7
  aws:elasticbeanstalk:container:docker:staticfiles:
    /static: static
  aws:elasticbeanstalk:application:environment:
    JAVA_HOME: /usr/lib/jvm/java-11-openjdk-amd64
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 10
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.medium
    SecurityGroups: default
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role
  aws:elbv2:loadbalancer:
    IdleTimeout: 60
  aws:elbv2:listener:80:
    Protocol: HTTP
    Port: 80
  aws:elbv2:listener:443:
    Protocol: HTTPS
    Port: 443
    SSLCertificateArns: arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERT_ID
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7
  aws:elasticbeanstalk:cloudwatch:logs:health:
    HealthStreamingEnabled: true
    DeleteOnTerminate: false
    RetentionInDays: 7
