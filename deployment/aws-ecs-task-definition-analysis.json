{
  "family": "eternaljukebox-analysis",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "eternaljukebox-analysis",
      "image": "{{IMAGE_URI}}",
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "FLASK_ENV",
          "value": "production"
        },
        {
          "name": "PYTHONPATH",
          "value": "/app"
        },
        {
          "name": "WORKERS",
          "value": "2"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/eternaljukebox-analysis",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:5000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 45
      },
      "mountPoints": [
        {
          "sourceVolume": "analysis-data",
          "containerPath": "/tmp/audio_uploads",
          "readOnly": false
        },
        {
          "sourceVolume": "analysis-cache",
          "containerPath": "/tmp/analysis_cache",
          "readOnly": false
        }
      ],
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ],
      "stopTimeout": 30,
      "startTimeout": 60,
      "resourceRequirements": [
        {
          "type": "GPU",
          "value": "0"
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "analysis-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_FILE_SYSTEM_ID}}",
        "rootDirectory": "/analysis-data",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "analysis-cache",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_FILE_SYSTEM_ID}}",
        "rootDirectory": "/analysis-cache",
        "transitEncryption": "ENABLED"
      }
    }
  ],
  "placementConstraints": [],
  "tags": [
    {
      "key": "Environment",
      "value": "{{ENVIRONMENT}}"
    },
    {
      "key": "Application",
      "value": "EternalJukebox"
    },
    {
      "key": "Service",
      "value": "Analysis"
    }
  ]
}
